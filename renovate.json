{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": [
    "every weekend"
  ],
  "prConcurrentLimit": 15,
  "enabledManagers": [
    "docker-compose",
    "helm-values",
    "flux"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "docker-compose updates",
      "matchManagers": [
        "docker-compose"
      ],
      "commitMessagePrefix": "chore(docker):",
      "commitMessageAction": "bump"
    },
    {
      "description": "helm values updates",
      "matchManagers": [
        "helm-values"
      ],
      "commitMessagePrefix": "chore(kube):",
      "commitMessageAction": "bump"
    },
    {
      "description": "Flux HelmRelease chart version updates",
      "matchManagers": [
        "flux"
      ],
      "commitMessagePrefix": "chore(kube):",
      "commitMessageAction": "bump chart"
    }
  ]
}
